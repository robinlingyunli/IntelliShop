# Copy this file to .env for local development (.env is already in .gitignore, won't be committed)
# Credentials must match the POSTGRES_* values in the root docker-compose .env

DATABASE_URL=postgresql+asyncpg://intellishop:intellishop_dev_password@localhost:5433/intellishop
JWT_SECRET_KEY=change_this_to_a_random_secret_in_your_own_.env

# AI agent (Anthropic API — get a key at console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Comma-separated list of frontend origins allowed to call this API.
# Defaults to http://localhost:3000 if unset — only needed in production.
ALLOWED_ORIGINS=http://localhost:3000
